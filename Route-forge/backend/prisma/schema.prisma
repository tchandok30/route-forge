generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Vehicle {
  id            Int          @id @default(autoincrement())
  vehicleNumber String       @unique @map("vehicle_number") @db.VarChar(20)
  vehicleType   String       @map("vehicle_type") @db.VarChar(50)
  capacity      Int
  operatingCost Decimal      @map("operating_cost") @db.Decimal(10, 2)
  status        String       @default("AVAILABLE") @db.VarChar(20)

  assignments Assignment[]

  @@map("vehicles")
}

model Driver {
  id            Int          @id @default(autoincrement())
  name          String       @db.VarChar(100)
  phone         String       @db.VarChar(15)
  licenseNumber String       @unique @map("license_number") @db.VarChar(30)
  status        String       @default("AVAILABLE") @db.VarChar(20)

  assignments Assignment[]

  @@map("drivers")
}

model Location {
  id       Int      @id @default(autoincrement())
  name     String   @db.VarChar(100)
  address  String?  @db.VarChar(255)
  latitude Decimal  @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  pickupOrders   Order[] @relation("PickupLocation")
  deliveryOrders Order[] @relation("DeliveryLocation")

  @@map("locations")
}

model Order {
  id                 Int      @id @default(autoincrement())
  customerName       String   @map("customer_name") @db.VarChar(100)
  weight             Decimal  @db.Decimal(10, 2)
  priority           String   @db.VarChar(20)
  deadline           DateTime
  status             String   @default("PENDING") @db.VarChar(20)
  createdAt          DateTime @default(now()) @map("created_at")
  deliveryCost       Decimal  @default(0) @map("delivery_cost") @db.Decimal(10, 2)

  pickupLocationId   Int @map("pickup_location_id")
  deliveryLocationId Int @map("delivery_location_id")

  pickupLocation   Location @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  deliveryLocation Location @relation("DeliveryLocation", fields: [deliveryLocationId], references: [id])

  assignments Assignment[]

  @@map("orders")
}

model Assignment {
  id         Int      @id @default(autoincrement())
  orderId    Int      @map("order_id")
  vehicleId  Int      @map("vehicle_id")
  driverId   Int      @map("driver_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  order   Order   @relation(fields: [orderId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])

  @@map("assignments")
}